# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://nsukhbwiltwghzmxgpwb.supabase.co

# Anon key (public — safe to embed in mobile client)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5zdWtoYndpbHR3Z2h6bXhncHdiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU5Njg0NTIsImV4cCI6MjEwMTU0NDQ1Mn0.1gflwK8J_EdeoqcWX7o0fGmk_d_VYEDWGmFWUoT1mYU

# Service-role key (SECRET — backend only, bypasses RLS for storage uploads)
# Find in: Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage bucket name for uploaded leaf images
SUPABASE_STORAGE_BUCKET=diagnosis-images

# -----------------------------------------------------------------------------
# HHC-VNDC Model Checkpoints
# Set each variable to the ABSOLUTE path of the corresponding .pt / .pth file.
# -----------------------------------------------------------------------------

# Stage 1 — EfficientNetV2-S + Swin-T vegetable classifier
HHC_STAGE1_CHECKPOINT=C:/path/to/checkpoints/stage1_hhc.pth

# Stage 2 — Per-vegetable EfficientNetV2-S expert classifiers
HHC_EXPERT_AMPALAYA_CHECKPOINT=C:/path/to/checkpoints/expert_ampalaya.pth
HHC_EXPERT_KALABASA_CHECKPOINT=C:/path/to/checkpoints/expert_kalabasa.pth
HHC_EXPERT_OKRA_CHECKPOINT=C:/path/to/checkpoints/expert_okra.pth
HHC_EXPERT_SITAW_CHECKPOINT=C:/path/to/checkpoints/expert_sitaw.pth
HHC_EXPERT_TALONG_CHECKPOINT=C:/path/to/checkpoints/expert_talong.pth

# Inference device: "cpu" (default) or "cuda" (requires CUDA-enabled GPU + torch-cuda)
HHC_DEVICE=cpu
